<% featured_articles = articles.where(category_id: categories).search_by_status(:published).order_by_views.limit(6) %>
<% article_link_style = portal.config&.dig('article_link_style').presence || 'boxed' %>
<% article_link_classes = if article_link_style == 'minimal'
  'group rounded-lg border border-transparent px-1 py-1 text-sm leading-6 text-slate-700 transition-all hover:border-transparent hover:bg-transparent dark:text-slate-100 dark:hover:border-transparent dark:hover:bg-transparent'
else
  'group rounded-xl border border-transparent px-3 py-2 text-sm leading-6 text-slate-700 transition-all hover:border-slate-200 hover:bg-white/80 dark:text-slate-100 dark:hover:border-slate-700 dark:hover:bg-slate-900/60'
end %>
<% if featured_articles.count >= 6 %>
<section class="flex flex-col w-full h-full lg:container">
  <div class="portal-card flex flex-col gap-4 border border-solid rounded-2xl border-slate-200/80 bg-white/80 px-4 py-5 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-slate-900/70">
    <div class="flex items-center justify-between w-full">
      <div class="flex items-center gap-2">
        <span class="inline-flex h-7 items-center rounded-full bg-slate-900/5 px-2.5 text-xs font-medium text-slate-700 dark:bg-slate-100/10 dark:text-slate-200">
          Top
        </span>
        <h3 class="portal-card-title text-lg md:text-xl font-semibold leading-tight text-slate-900 dark:text-slate-50">
          <%= I18n.t('public_portal.header.featured_articles') %>
        </h3>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
      <% featured_articles.each do |article| %>
        <a class="portal-card-link <%= article_link_classes %>" href="<%= generate_article_link(portal.slug, article.slug, @theme_from_params, @is_plain_layout_enabled) %>">
          <div id="category-item" class="flex items-start justify-between gap-4">
            <span class="line-clamp-2 font-medium"><%= article.title %></span>
            <span class="mt-1 flex items-center opacity-60 transition-opacity group-hover:opacity-100">
              <%= render partial: 'icons/chevron-right' %>
            </span>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</section>
<% end %>
