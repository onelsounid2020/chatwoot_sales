<% category_link_params = {
      portal_slug: portal.slug,
      category_locale: category.locale,
      category_slug: category.slug,
      theme: @theme_from_params,
      is_plain_layout_enabled: @is_plain_layout_enabled
    }
%>
<% article_link_style = portal.config&.dig('article_link_style').presence || 'boxed' %>
<% article_link_classes = if article_link_style == 'minimal'
  'group/item rounded-lg border border-transparent px-1 py-1 text-sm leading-6 text-slate-700 transition-all hover:border-transparent hover:bg-transparent dark:text-slate-100 dark:hover:border-transparent dark:hover:bg-transparent'
else
  'group/item rounded-xl border border-transparent px-3 py-2 text-sm leading-6 text-slate-700 transition-all hover:border-slate-200 hover:bg-white/80 dark:text-slate-100 dark:hover:border-slate-700 dark:hover:bg-slate-900/60'
end %>

<section class="flex flex-col w-full h-full lg:container">
  <div id="<%= !@is_plain_layout_enabled ? 'category-block' : '' %>" class="portal-card group flex h-full flex-col gap-5 rounded-2xl border border-solid border-slate-200/80 bg-white/85 p-5 shadow-sm transition-all hover:shadow-md dark:border-slate-800 dark:bg-slate-900/70">
    <div class="flex items-start justify-between gap-3">
      <div class="flex min-w-0 flex-col gap-1">
        <div class="flex items-center gap-2">
          <% if category.icon.present? %>
            <span class="inline-flex size-7 items-center justify-center rounded-lg bg-slate-900/5 text-sm dark:bg-slate-100/10"><%= category.icon %></span>
          <% end %>
          <h3 id="<%= !@is_plain_layout_enabled ? 'category-name' : '' %>" class="portal-card-title truncate text-lg font-semibold leading-tight text-slate-900 dark:text-slate-50">
            <a href="<%= generate_category_link(category_link_params) %>" class="<%= @is_plain_layout_enabled ? 'hover:underline' : '' %>">
              <%= category.name %>
            </a>
          </h3>
        </div>
        <% if category.description.present? %>
          <span class="portal-card-text line-clamp-2 text-sm text-slate-600 dark:text-slate-400"><%= category.description %></span>
        <% end %>
      </div>
    </div>
    <div class="flex flex-1 flex-col gap-1.5">
      <% if category.articles.published.size == 0 %>
        <div class="flex h-full items-center justify-center rounded-xl border border-dashed border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800/60">
          <p class="portal-card-text text-sm text-slate-500"><%= I18n.t('public_portal.common.no_articles') %></p>
        </div>
      <% else %>
        <% category.articles.published.order(position: :asc).take(5).each do |article| %>
          <a class="portal-card-link <%= article_link_classes %>" href="<%= generate_article_link(portal.slug, article.slug, @theme_from_params, @is_plain_layout_enabled) %>">
            <div id="<%= !@is_plain_layout_enabled ? 'category-item' : '' %>" class="flex items-start justify-between gap-3">
              <span class="line-clamp-2"><%= article.title %></span>
              <span class="mt-1 flex items-center opacity-60 transition-opacity group-hover/item:opacity-100">
                <%= render partial: 'icons/chevron-right' %>
              </span>
            </div>
          </a>
        <% end %>
      <% end %>
    </div>
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-slate-200/70 pt-3 dark:border-slate-800">
      <div class="flex min-w-0 flex-row items-center gap-1.5">
        <%= render "public/api/v1/portals/authors", category: category, show_expanded: false %>
        <span class="portal-card-text text-slate-500 dark:text-slate-400">•</span>
        <span class="portal-card-text truncate text-xs font-medium text-slate-600 dark:text-slate-400"><%= render 'public/api/v1/portals/article_count', article_count: category.articles.published.order(position: :asc).size %></span>
      </div>
      <a href="<%= generate_category_link(category_link_params) %>" class="portal-card-link shrink-0 text-xs font-semibold tracking-wide text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100">
        <%= I18n.t('public_portal.common.view_all_articles') %>
      </a>
    </div>
  </div>
</section>
