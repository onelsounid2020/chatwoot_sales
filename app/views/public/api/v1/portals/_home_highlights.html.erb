<% return if most_viewed_articles.blank? && recent_articles.blank? %>

<section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <div class="portal-card flex h-full flex-col gap-4 rounded-2xl border border-slate-200/80 bg-white/85 p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/70">
    <div class="flex items-center justify-between">
      <h3 class="portal-card-title text-lg font-semibold leading-tight text-slate-900 dark:text-slate-50">
        <%= I18n.t('public_portal.article_page.most_viewed_articles') %>
      </h3>
    </div>
    <div class="space-y-2">
      <% most_viewed_articles.each do |article| %>
        <a
          class="portal-card-link block rounded-xl border border-transparent px-3 py-2 text-sm transition-all hover:border-slate-200 hover:bg-white/80 dark:hover:border-slate-700 dark:hover:bg-slate-900/60"
          href="<%= generate_article_link(portal.slug, article.slug, @theme_from_params, @is_plain_layout_enabled) %>"
        >
          <%= article.title %>
        </a>
      <% end %>
    </div>
  </div>

  <div class="portal-card flex h-full flex-col gap-4 rounded-2xl border border-slate-200/80 bg-white/85 p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/70">
    <div class="flex items-center justify-between">
      <h3 class="portal-card-title text-lg font-semibold leading-tight text-slate-900 dark:text-slate-50">
        <%= I18n.t('public_portal.article_page.recently_updated', default: 'Recently updated') %>
      </h3>
    </div>
    <div class="space-y-2">
      <% recent_articles.each do |article| %>
        <a
          class="portal-card-link block rounded-xl border border-transparent px-3 py-2 text-sm transition-all hover:border-slate-200 hover:bg-white/80 dark:hover:border-slate-700 dark:hover:bg-slate-900/60"
          href="<%= generate_article_link(portal.slug, article.slug, @theme_from_params, @is_plain_layout_enabled) %>"
        >
          <%= article.title %>
        </a>
      <% end %>
    </div>
  </div>
</section>
